<config>
    <!-- AVF resource (android.system.virtualmachine.res) This defines permissions for AVF. Should
    be available to all types of users -->
    <install-in-user-type package="com.android.virtualmachine.res">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- AVF resource (android.system.virtualmachine.res) This defines permissions for AVF. Should
    be available to all types of users -->
    <install-in-user-type package="com.google.android.virtualmachine.res">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- Terminal (VmTerminalApp) This app is installe to all human users and managed profiles.
    However, it doesn't mean that this app is displayed by default when such a new user is created.
    Instead, the app's main activity is explicitly enabled if the user turns the "Linux Development"
    feature on in the development options menu in the Settings app. -->
    <install-in-user-type package="com.android.virtualization.terminal">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- EmptyPayloadApp (EmptyPayloadApp) This is for compliance tests only. It's not shown in
    the app launcher. -->
    <install-in-user-type package="com.android.microdroid.empty_payload">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>

    <!-- EmptyPayloadAppGoogle (EmptyPayloadAppGoogle) This is for compliance tests only. It's not
    shown in the app launcher. -->
    <install-in-user-type package="com.google.android.microdroid.empty_payload">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>

    <!-- ComposPayloadApp (ComposPayloadApp) This isn't shown in the app launcher. -->
    <install-in-user-type package="com.android.compos.payload">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>

    <!-- ComposPayloadAppGoogle (ComposPayloadAppGoogle) This isn't shown in the app launcher. -->
    <install-in-user-type package="com.google.android.compos.payload">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>
</config>
