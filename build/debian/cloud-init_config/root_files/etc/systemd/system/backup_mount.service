[Unit]
Description=Mount backup rootfs
After=network.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/bin/bash -c '[ -e "/dev/vdc" ] && (mkdir -p /mnt/backup; chown 1000:100 /mnt/backup; mount /dev/vdc /mnt/backup) || (rm -rf /mnt/backup)'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
