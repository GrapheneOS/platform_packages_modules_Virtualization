[Unit]
Description=Debian guest agent
After=syslog.target
ConditionPathExists=/usr/bin/linux_vm_manager

[Service]
ExecStart=/usr/bin/linux_vm_manager
Type=simple
Restart=on-failure
RestartSec=1
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

