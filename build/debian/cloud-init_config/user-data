#cloud-config

# cloud-init boots modules in predefined order as follows:
#   - network
#   - write_files (`defer` can be specified to run this later)
#   - users
#   - bootcmd
#   - packages
#   - runcmd

users:
  - default
  - name: droid
    gecos: Default user for Terminal App
    lock_passwd: false
    no_user_group: true
    groups: sudo, video, renderer
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /usr/bin/bash
    plain_text_passwd: droid
    uid: 1000

# Write files at /home/droid here to set ownership
write_files:
  - content: |
      # Show title of current running command
      trap 'echo -ne "\e]0;\$BASH_COMMAND\007"' DEBUG
    path: /home/droid/.bash_aliases
    permission: '0644'
    owner: droid:users
    defer: true

runcmd:
  - mkdir /mnt/cidata
  - mount /dev/vdb /mnt/cidata
  - /mnt/cidata/init.sh
  - umount /mnt/cidata
  - rm -r /mnt/cidata
