#cloud-config

# This is the same with the default netplan setting,
# but this is required to prevent hang of systemd-networkd-wait-online.

network:
    version: 2
    ethernets:
        all-en:
            match:
                name: en*
            dhcp4: true
            dhcp4-overrides:
                use-dns: false
                use-domains: true
            dhcp6: true
            dhcp6-overrides:
                use-dns: false
                use-domains: true
            nameservers:
                addresses: [1.1.1.1, 8.8.8.8]
