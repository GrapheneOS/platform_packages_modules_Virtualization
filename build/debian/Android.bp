// This module is only expected to be used in Debian linux running inside the VM.
// There's no guarantee that this module works well on the Android.
genrule {
    name: "debian_cidata",
    srcs: [
        "cloud-init_config/user-data", // anchor for finding config root dir
        "cloud-init_config/**/*",
    ],
    out: ["cidata.iso"],
    tools: ["xorriso"],
    cmd: "ROOT_DIR=$(location cloud-init_config/user-data)/..; " +
        "chmod o=g $(in); " +
        "$(location xorriso) -as mkisofs -V cidata -J -uid 0 -gid 0 -o $(out) -R $${ROOT_DIR}",
}

prebuilt_etc {
    name: "debian_cidata.iso",
    src: ":debian_cidata",
    filename: "cidata.iso",
}
