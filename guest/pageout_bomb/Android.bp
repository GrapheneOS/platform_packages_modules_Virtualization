package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "pageout_bomb_defaults",
    crate_name: "pageout_bomb",
    srcs: ["src/main.rs"],
    edition: "2024",
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libandroid_logger",
        "liblibc",
        "liblog_rust",
    ],
    init_rc: ["pageout_bomb.rc"],
    multilib: {
        lib32: {
            enabled: false,
        },
    },
}

rust_binary {
    name: "pageout_bomb",
    defaults: ["pageout_bomb_defaults"],
}

rust_test {
    name: "pageout_bomb_test",
    defaults: ["pageout_bomb_defaults"],
    test_suites: ["general-tests"],
}
