package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_static {
    name: "libservice_vm",
    crate_name: "service_vm",
    srcs: ["src/main.rs"],
    defaults: ["vmbase_ffi_defaults"],
    rustlibs: [
        "libbssl_avf_nostd",
        "libciborium_io_nostd",
        "libciborium_nostd",
        "libdiced_open_dice_nostd",
        "libhypervisor_backends",
        "liblibfdt_nostd",
        "liblog_rust_nostd",
        "libservice_vm_comm_nostd",
        "libservice_vm_fake_chain_nostd",
        "libservice_vm_requests_nostd",
        "libtinyvec_nostd",
        "libvirtio_drivers",
        "libvmbase",
    ],
}

cc_binary {
    name: "service_vm_elf",
    stem: "service_vm",
    defaults: ["vmbase_elf_0x80000000_defaults"],
    static_libs: [
        "libservice_vm",
        "libvmbase_dice_clear_memory",
    ],
    linker_scripts: [
        "image.ld",
        ":vmbase_sections",
    ],
}

raw_binary {
    name: "service_vm_unsigned",
    src: ":service_vm_elf",
    enabled: false,
    target: {
        android_arm64: {
            enabled: true,
        },
    },
}

// python -c "import hashlib; print(hashlib.sha256(b'service_vm_salt').hexdigest())"
service_vm_salt = "52af8246bb7dc5da9170255c8ab0c1ebaf5794ed50a493c4630baed3251ae7d2"

filegroup {
    name: "service_vm_sign_key",
    srcs: [":avb_testkey_rsa4096"],
}

// This name is reserved and recognized by pvmfw; see guest/pvmfw/README.md.
SERVICE_VM_NAME = "rkp_vm"
// Both SERVICE_VM_VERSION and SERVICE_VM_VERSION_STRING should represent the
// same version number for the service VM.
SERVICE_VM_VERSION = 2
SERVICE_VM_VERSION_STRING = "2"

genrule {
    name: "service_vm_version_rs",
    out: ["lib.rs"],
    cmd: "(" +
        "    echo '#![no_std]';" +
        "    echo '#![allow(missing_docs)]';" +
        "    echo 'pub const VERSION: u64 = " + SERVICE_VM_VERSION_STRING + ";'" +
        ") > $(out)",
}

rust_library_rlib {
    name: "libservice_vm_version",
    crate_name: "service_vm_version",
    defaults: ["vmbase_rlib_defaults"],
    srcs: [":service_vm_version_rs"],
}

avb_add_hash_footer {
    name: "service_vm_signed",
    src: ":empty_file",
    filename: "service_vm",
    partition_name: "boot",
    private_key: ":service_vm_sign_key",
    salt: service_vm_salt,
    rollback_index: SERVICE_VM_VERSION,
    props: [
        {
            name: "com.android.virt.cap",
            value: "remote_attest",
        },
        {
            name: "com.android.virt.name",
            value: SERVICE_VM_NAME,
        },
    ],
    enabled: false,
    arch: {
        arm64: {
            src: ":service_vm_unsigned",
            enabled: true,
        },
    },
}

prebuilt_etc {
    // service_vm_bin is a prebuilt target wrapping the signed bare-metal service VM.
    name: "service_vm_bin",
    filename: "service_vm.bin",
    target: {
        android_arm64: {
            src: ":service_vm_signed",
        },
    },
    src: ":empty_file",
    installable: false,
}

rust_test {
    name: "service_vm_test",
    crate_name: "service_vm_test",
    defaults: ["avf_build_flags_rust"],
    srcs: ["tests/test.rs"],
    prefer_rlib: true,
    edition: "2021",
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libandroid_logger",
        "libanyhow",
        "libbssl_avf_nostd",
        "libclient_vm_csr",
        "libcoset",
        "liblibc",
        "liblog_rust",
        "libhwtrust",
        "libhypervisor_props",
        "libservice_vm_comm",
        "libservice_vm_fake_chain",
        "libservice_vm_manager",
        "libvmclient",
        "libx509_cert_nostd",
    ],
    data: [
        ":service_vm_unsigned",
        ":test_rkp_cert_chain",
    ],
    test_suites: ["general-tests"],
    enabled: false,
    target: {
        android_arm64: {
            enabled: true,
        },
    },
}
