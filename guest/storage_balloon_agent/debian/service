[Unit]
After=syslog.target
After=network.target

[Service]
PassEnvironment=debian_server_port
ExecStart=/usr/bin/bash -c '/usr/bin/storage_balloon_agent --grpc-port $debian_server_port'
Type=simple
Restart=on-failure
RestartSec=1
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
