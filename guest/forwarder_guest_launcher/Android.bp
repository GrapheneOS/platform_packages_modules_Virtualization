// This module is only expected to be used in Debian linux running inside the VM.
// There's no guarantee that this module works well on the Android.
rust_library {
    name: "libforwarder_guest_launcher",
    srcs: ["src/lib.rs"],
    crate_name: "forwarder_guest_launcher",
    edition: "2021",
    rustlibs: [
        "libanyhow",
        "liblog_rust",
        "libnix",
        "libtokio",
        "liblinux",
    ],
    host_supported: true,
    apex_available: ["com.android.virt"],
}
