package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "security_vm_launcher-arm64_combined",
    srcs: [
        "security_vm_launcher-arm64.rc.base",
    ] + select(soong_config_variable("trusty_system_vm", "placeholder_trusted_hal"), {
        true: [],
        default: ["security_vm_launcher-arm64.rc.ffa"],
    }) + [
        "security_vm_launcher-arm64.rc.suffix",
    ] + select(soong_config_variable("trusty_system_vm", "placeholder_trusted_hal"), {
        true: ["security_vm_launcher-arm64.rc.placeholder"],
        default: [],
    }),
    out: ["security_vm_launcher-arm64.rc"],
    cmd: "cat $(in) > $(out)",
}

prebuilt_etc {
    name: "trusty_security_vm_launcher.rc",
    src: select((os(), arch(), soong_config_variable("trusty_system_vm", "enabled")), {
        ("android", "arm64", true): ":security_vm_launcher-arm64_combined",
        ("android", "x86_64", true): "security_vm_launcher-x86_64.rc",
        (default, default, default): ":empty_file",
    }),
    filename: "trusty_security_vm_launcher.rc",
    relative_install_path: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "trusty_security_vm_rpc_services.json",
    src: select(soong_config_variable("trusty_system_vm", "placeholder_trusted_hal"), {
        true: "security_vm_rpc_services_hal_placeholders.json",
        default: "security_vm_rpc_services.json",
    }),
    system_ext_specific: true,
    relative_install_path: "vm/trusty_vm",
    filename: "security_vm_rpc_services.json",
}

rust_binary {
    name: "trusty_security_vm_launcher",
    crate_name: "trusty_security_vm_launcher",
    srcs: ["src/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libvm_launcher",
        "libanyhow",
        "libclap",
        "libenv_logger",
        "liblog_rust",
        "libserde",
        "libserde_json",
        "libvmclient",
        "libnix",
    ],
    bootstrap: true,
    system_ext_specific: true,
}

rust_library {
    name: "libvm_launcher",
    crate_name: "vm_launcher",
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "android.system.virtualizationservice-rust",
        "libanyhow",
        "libhypervisor_props",
        "liblog_rust",
        "libvmclient",
    ],
}

prebuilt_etc {
    name: "trusty_security_vm_instance_id",
    src: ":security_vm_instance_id",
    system_ext_specific: true,
    relative_install_path: "vm/trusty_vm",
    filename: "security_vm_instance_id",
}

genrule {
    name: "security_vm_instance_id",
    srcs: ["security_vm_instance_id_config.json"],
    out: ["security_vm_instance_id"],
    tools: [
        "gen_instance_id_for_vm_with_trusted_hal",
    ],
    cmd: "$(location gen_instance_id_for_vm_with_trusted_hal) -i $(in) -o $(out)",
}
