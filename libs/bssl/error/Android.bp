package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libbssl_avf_error_defaults",
    crate_name: "bssl_avf_error",
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    apex_available: [
        "com.android.virt",
    ],
}

rust_library {
    name: "libbssl_avf_error",
    defaults: ["libbssl_avf_error_defaults"],
    features: [
        "std",
    ],
    rustlibs: [
        "libcoset",
        "liblog_rust",
        "libserde",
    ],
    vendor_available: true,
    no_std: {
        features: [],
        enabled: true,
    },
}
