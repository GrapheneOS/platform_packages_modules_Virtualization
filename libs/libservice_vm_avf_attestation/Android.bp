package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libservice_vm_avf_attestation_nostd_defaults",
    compile_multilib: "first",
    crate_name: "service_vm_avf_attestation",
    defaults: ["avf_build_flags_rust"],
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    no_stdlibs: true,
    stdlibs: [
        "libcore.rust_sysroot",
    ],
    no_std_rlibs: [
        "libavf_attestation_nostd",
        "libcoset_nostd",
        "libbssl_avf_nostd",
        "libder_nostd",
        "libdiced_open_dice_nostd",
        "liblog_rust_nostd",
        "libservice_vm_comm_nostd",
        "libzeroize_nostd",
    ],
}

rust_library_rlib {
    name: "libservice_vm_avf_attestation_nostd",
    defaults: ["libservice_vm_avf_attestation_nostd_defaults"],
    apex_available: [
        "com.android.virt",
    ],
}
