<configuration description="Install a test APK and then run an API test">
    <option name="test-suite-tag" value="cts"/>
    <!-- Target Preparer: Installs the APK that will be compiled by the test -->
    <target_preparer class="com.android.tradefed.targetprep.TestAppInstallSetup">
        <option name="test-file-name" value="TestAppForCompilation.apk" />
    </target_preparer>
    <!-- Target Preparer: Disable SELinux to allow the test to call into CompOS binder.-->
    <target_preparer class="com.android.tradefed.targetprep.DisableSELinuxTargetPreparer" />
    <!-- Target Preparer: Enable the compos feature flag.-->
    <target_preparer class="com.android.tradefed.targetprep.AFlagsTargetPreparer">
        <option name="flag-value" value="hardware_backed_security/com.android.compos.verified_dex2oat=true" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true"/>
        <option name="push" value="verified_dex2oat_api_test->/data/local/tmp/verified_dex2oat_api_test" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.GTest">
        <option name="native-test-device-path" value="/data/local/tmp" />
        <option name="module-name" value="verified_dex2oat_api_test" />
    </test>
</configuration>