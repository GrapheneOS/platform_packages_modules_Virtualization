<configuration description="Configuration for the libcompos_wrappers_test.">
    <option name="test-suite-tag" value="libcompos_wrappers_test" />

    <!-- Target Preparer: Disable SELinux to allow the test to call into CompOS binder.-->
    <target_preparer class="com.android.tradefed.targetprep.DisableSELinuxTargetPreparer" />

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="push-file" key="libcompos_wrappers_test" value="/data/local/tmp/libcompos_wrappers_test" />
        <option name="cleanup" value="true" />
    </target_preparer>

    <test class="com.android.tradefed.testtype.rust.RustBinaryTest" >
        <option name="test-device-path" value="/data/local/tmp" />
        <option name="module-name" value="libcompos_wrappers_test"/>
        <!-- Rust tests are run in parallel by default. Run these ones
            single-threaded to prevent tests from interfering with
            one another.-->
        <option name="native-test-flag" value="--test-threads=1" />
    </test>
</configuration>
