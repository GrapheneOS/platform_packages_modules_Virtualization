package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libhw_timeout_multiplier",
    crate_name: "hw_timeout_multiplier",
    defaults: ["avf_build_flags_rust"],
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "librustutils",
    ],
    apex_available: [
        "com.android.compos",
        "com.android.virt",
    ],
}
