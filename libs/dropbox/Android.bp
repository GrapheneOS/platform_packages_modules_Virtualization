package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library {
    name: "libvirt_dropbox",
    crate_name: "virt_dropbox",
    srcs: ["src/lib.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "liblog_rust",
        "liblogger",
        "librustutils",
    ],
    apex_available: ["com.android.virt"],
    // Limit visibility as only virtualizationmanager, running in host, has the capabilities that the library needs to
    // populate the dropbox header properly.
    visibility: ["//packages/modules/Virtualization/android/virtmgr"],
}
