package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "authfs_aidl_interface",
    unstable: true,
    srcs: ["com/android/virt/fs/*.aidl"],
    backend: {
        rust: {
            enabled: true,
            gen_mockall: true,
            additional_rustlibs: [
                "libmockall",
            ],
            apex_available: [
                "com.android.compos",
                "com.android.virt",
            ],
        },
    },
}
