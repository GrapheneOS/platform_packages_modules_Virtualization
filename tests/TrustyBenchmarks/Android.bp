package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "TrustyBenchmarks",
    srcs: ["src/**/*.java"],
    static_libs: [
        "androidx.test.runner",
        "androidx.test.rules",
        "junit",
        "truth",
        "compatibility-device-util-axt",
        "MicrodroidCommonTestLib",
    ],
    jni_libs: [
        "libtrustybenchmarks_jni",
        "libbinder_rpc_unstable",
    ],
    test_suites: ["general-tests"],
    device_first_data: [
        ":trusty_security_vm.elf",
    ],
}

rust_ffi_shared {
    name: "libtrustybenchmarks_jni",
    crate_name: "trustybenchmarks_jni",
    srcs: ["src/native/trusty_benchmarks_jni.rs"],
    prefer_rlib: true,
    rustlibs: [
        "libandroid_logger",
        "libanyhow",
        "liblog_rust",
        "libvm_launcher",
        "libjni",
        "libonce_cell",
        "libvmclient",
    ],
}
