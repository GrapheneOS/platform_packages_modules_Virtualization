package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_key {
    name: "com.android.microdroid.test.tenant0.key",
    public_key: "com.android.microdroid.test.tenant0.avbpubkey",
    private_key: "com.android.microdroid.test.tenant0.pem",
}

android_app_certificate {
    name: "com.android.microdroid.test.tenant0.certificate",
    certificate: "com.android.microdroid.test.tenant0",
}

apex {
    name: "com.android.microdroid.test.tenant0",
    manifest: "manifest.json",
    file_contexts: ":apex.test-file_contexts",
    key: "com.android.microdroid.test.tenant0.key",
    certificate: ":com.android.microdroid.test.tenant0.certificate",
    jni_libs: [
        "MicrodroidEmptyTenant",
    ],
    updatable: false,
}

cc_library {
    name: "MicrodroidEmptyTenant",
    defaults: ["avf_build_flags_cc"],
    srcs: ["empty_binary.cpp"],
    shared_libs: ["libvm_payload#current"],
    installable: true,
    apex_available: ["com.android.microdroid.test.tenant0"],
    compile_multilib: "first",
    stl: "none",
}
