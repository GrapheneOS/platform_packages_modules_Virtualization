package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "test_avf_debug_policy_with_ramdump",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_with_ramdump.dts"],
    out: ["avf_debug_policy_with_ramdump.dtbo"],
}

genrule {
    name: "test_avf_debug_policy_without_ramdump",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_without_ramdump.dts"],
    out: ["avf_debug_policy_without_ramdump.dtbo"],
}

genrule {
    name: "test_avf_debug_policy_with_adb",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_with_adb.dts"],
    out: ["avf_debug_policy_with_adb.dtbo"],
}

genrule {
    name: "test_avf_debug_policy_without_adb",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_without_adb.dts"],
    out: ["avf_debug_policy_without_adb.dtbo"],
}

genrule {
    name: "test_avf_debug_policy_with_log",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_with_log.dts"],
    out: ["avf_debug_policy_with_log.dtbo"],
}

genrule {
    name: "test_avf_debug_policy_without_log",
    defaults: ["dts_to_dtb"],
    srcs: ["avf_debug_policy_without_log.dts"],
    out: ["avf_debug_policy_without_log.dtbo"],
}

filegroup {
    name: "test_avf_bcc_dat",
    srcs: ["dice.dat"],
}
