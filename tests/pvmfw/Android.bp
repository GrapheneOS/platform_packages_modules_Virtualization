package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "CustomPvmfwHostTestCases",
    srcs: ["java/**/*.java"],
    test_suites: ["general-tests"],
    libs: [
        "androidx.annotation_annotation",
        "tradefed",
    ],
    static_libs: [
        "MicrodroidHostTestLib",
        "PvmfwHostTestLib",
        "compatibility-host-util",
        "cts-host-utils",
    ],
    per_testcase_directory: true,
    data: [
        ":test_avf_bcc_dat",
    ],
    device_common_data: [
        ":MicrodroidTestHelperApp",
        ":test_avf_debug_policy_with_ramdump",
        ":test_avf_debug_policy_without_ramdump",
        ":test_avf_debug_policy_with_adb",
        ":test_avf_debug_policy_without_adb",
        ":test_avf_debug_policy_with_log",
        ":test_avf_debug_policy_without_log",
    ],
    device_first_data: [
        ":pvmfw_test",
    ],
    data_device_bins_first: ["dtc_static"],
}
